# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=afb_mangaan_db
DB_USER=root
DB_PASS=

# Application Secrets
# Used for JWT tokens, session hashing, etc. Generate a long, random string.
APP_SECRET=your_super_secret_app_key_here

# Webhook Configuration (Make.com or similar)
WEBHOOK_SECRET=your_webhook_secret_key_here
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_unique_webhook_id

# Environment
# Set to 'production' to disable detailed error reporting
APP_ENV=development
